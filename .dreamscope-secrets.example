# Dreamscope activation secrets — COPY to .dreamscope-secrets and fill in.
# This file is GITIGNORED. The self-complete cron (activate-when-ready.mjs)
# enables Google login + regenerates neutral locales the moment all 5 exist.
#
# 1) Platform token (from https://supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=your-supabase-platform-token
# 2) Your Supabase project ref (the dreamscope project)
SUPABASE_PROJECT_REF=nrrmajmxnxbrsvfvlfvv
# 3) Google OAuth client (https://console.cloud.google.com/apis/credentials)
#    - Web application, redirect URI: https://nrrmajmxnxbrsvfvlfvv.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# 4) OpenRouter key (to regenerate the other 58 locales in neutral form)
OPENROUTER_API_KEY=sk-or-...
