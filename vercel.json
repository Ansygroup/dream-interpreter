{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/seo/:sym/:lang/:slug", "destination": "/seo/:sym/:lang/:slug.html" },
    { "source": "/seo/:sym/:lang", "destination": "/seo/:sym/:lang.html" },
    { "source": "/((?!api/|seo/|favicon|robots.txt|sitemap.xml|assets/).*)", "destination": "/index.html" }
  ]
}
