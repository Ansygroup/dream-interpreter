{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/seo/(.*)", "destination": "/api/seo" },
    { "source": "/([a-zA-Z0-9-]{8,128}\\.txt)", "destination": "/api/indexnow-key.txt.js" },
    { "source": "/((?!api/|seo/|favicon|robots.txt|sitemap.xml|assets/).*)", "destination": "/index.html" }
  ]
}
