{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/API_KEY.txt", "destination": "/api/indexnow-key.txt.js" },
    { "source": "/[a-zA-Z0-9-]{8,128}.txt", "destination": "/api/indexnow-key.txt.js" },
    { "source": "/seo/(.*)", "destination": "/api/seo" },
    { "source": "/((?!api/|seo/|favicon|robots.txt|sitemap.xml|API_KEY.txt|assets/|.*\\.txt).*)", "destination": "/index.html" }
  ]
}
